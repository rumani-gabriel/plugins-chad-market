# graph-explorer (modo local endurecido)

# Apaga el log local de queries del motor (~/.cache/graphify-queries.log).
GRAPHIFY_QUERY_LOG_DISABLE=1

# NO configures backends LLM externos. El código se extrae con tree-sitter (sin red)
# y los PDF/imágenes los lee el propio asistente en la sesión. Dejá estas SIN valor
# a propósito:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
